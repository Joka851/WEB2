{
    "Jwt": {
        "Key": "TravelPlannerSuperSecretKey123!@#",
        "Issuer": "TravelPlanner",
        "Audience": "TravelPlannerUsers"
    },
    "ReverseProxy": {
        "Routes": {
            "user-auth-route": {
                "ClusterId": "user-cluster",
                "Match": {
                    "Path": "/api/auth/{**catch-all}"
                }
            },
            "user-users-route": {
                "ClusterId": "user-cluster",
                "Match": {
                    "Path": "/api/users/{**catch-all}"
                }
            },
            "share-public-route": {
                "ClusterId": "travel-cluster",
                "Match": {
                    "Path": "/api/share/{**catch-all}"
                }
            },
            "finance-route": {
                "ClusterId": "finance-cluster",
                "Order": -10,
                "Match": {
                    "Path": "/api/travel-plans/{travelPlanId}/expenses/{**catch-all}"
                }
            },
            "travel-route": {
                "ClusterId": "travel-cluster",
                "Order": 0,
                "Match": {
                    "Path": "/api/travel-plans/{**catch-all}"
                }
            }
        },
        "Clusters": {
            "user-cluster": {
                "Destinations": {
                    "user-service": {
                        "Address": "http://localhost:8360"
                    }
                }
            },
            "travel-cluster": {
                "Destinations": {
                    "travel-service": {
                        "Address": "http://localhost:8700"
                    }
                }
            },
            "finance-cluster": {
                "Destinations": {
                    "finance-service": {
                        "Address": "http://localhost:8625"
                    }
                }
            }
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}