<?xml version="1.0" encoding="utf-8"?>
<ApplicationManifest xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                     ApplicationTypeName="TravelPlannerType"
                     ApplicationTypeVersion="1.0.0"
                     xmlns="http://schemas.microsoft.com/2011/01/fabric">
	<Parameters>
		<Parameter Name="FinanceService_ASPNETCORE_ENVIRONMENT" DefaultValue="" />
		<Parameter Name="TravelService_ASPNETCORE_ENVIRONMENT" DefaultValue="" />
		<Parameter Name="UserService_ASPNETCORE_ENVIRONMENT" DefaultValue="" />
		<Parameter Name="Gateway_ASPNETCORE_ENVIRONMENT" DefaultValue="" />
		<Parameter Name="TravelService_MinReplicaSetSize" DefaultValue="1" />
		<Parameter Name="TravelService_TargetReplicaSetSize" DefaultValue="1" />
		<Parameter Name="TravelService_PartitionCount" DefaultValue="1" />
	</Parameters>
	<ServiceManifestImport>
		<ServiceManifestRef ServiceManifestName="FinanceServicePkg" ServiceManifestVersion="1.0.0" />
		<ConfigOverrides />
		<EnvironmentOverrides CodePackageRef="Code">
			<EnvironmentVariable Name="ASPNETCORE_ENVIRONMENT" Value="[FinanceService_ASPNETCORE_ENVIRONMENT]" />
		</EnvironmentOverrides>
	</ServiceManifestImport>
	<ServiceManifestImport>
		<ServiceManifestRef ServiceManifestName="TravelServicePkg" ServiceManifestVersion="1.0.1" />
		<ConfigOverrides />
		<EnvironmentOverrides CodePackageRef="Code">
			<EnvironmentVariable Name="ASPNETCORE_ENVIRONMENT" Value="[TravelService_ASPNETCORE_ENVIRONMENT]" />
		</EnvironmentOverrides>
	</ServiceManifestImport>
	<ServiceManifestImport>
		<ServiceManifestRef ServiceManifestName="UserServicePkg" ServiceManifestVersion="1.0.0" />
		<ConfigOverrides />
		<EnvironmentOverrides CodePackageRef="Code">
			<EnvironmentVariable Name="ASPNETCORE_ENVIRONMENT" Value="[UserService_ASPNETCORE_ENVIRONMENT]" />
		</EnvironmentOverrides>
	</ServiceManifestImport>
	<ServiceManifestImport>
		<ServiceManifestRef ServiceManifestName="GatewayPkg" ServiceManifestVersion="1.0.0" />
		<ConfigOverrides />
		<EnvironmentOverrides CodePackageRef="Code">
			<EnvironmentVariable Name="ASPNETCORE_ENVIRONMENT" Value="[Gateway_ASPNETCORE_ENVIRONMENT]" />
		</EnvironmentOverrides>
	</ServiceManifestImport>
	<DefaultServices>
		<Service Name="Gateway">
			<StatelessService ServiceTypeName="GatewayType" InstanceCount="1">
				<SingletonPartition />
			</StatelessService>
		</Service>
		<Service Name="UserService">
			<StatelessService ServiceTypeName="UserServiceType" InstanceCount="1">
				<SingletonPartition />
			</StatelessService>
		</Service>
		<Service Name="FinanceService">
			<StatelessService ServiceTypeName="FinanceServiceType" InstanceCount="1">
				<SingletonPartition />
			</StatelessService>
		</Service>
		<Service Name="TravelService">
			<StatefulService ServiceTypeName="TravelServiceType"
			                  TargetReplicaSetSize="[TravelService_TargetReplicaSetSize]"
			                  MinReplicaSetSize="[TravelService_MinReplicaSetSize]">
				<UniformInt64Partition PartitionCount="[TravelService_PartitionCount]" LowKey="0" HighKey="9" />
			</StatefulService>
		</Service>
	</DefaultServices>
</ApplicationManifest>